      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT o.country, SUM(p.amount) AS revenue FROM payments p JOIN orders o USING(order_id) WHERE lower(p.payment_status) IN ('success','succeeded','completed') AND $__timeFilter(p.created_at) GROUP BY o.country ORDER BY revenue DESC",
