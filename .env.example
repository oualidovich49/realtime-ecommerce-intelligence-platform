# Copy to .env and set local credentials. Never commit .env.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce
DB_USER=analytics
DB_PASSWORD=change-me-locally

API_BASE_URL=https://dummyjson.com
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC=ecommerce.events
EVENT_RATE_PER_MINUTE=30
API_STALE_AFTER_HOURS=24

# Optional Grafana local admin password.
GRAFANA_ADMIN_PASSWORD=change-me-locally
