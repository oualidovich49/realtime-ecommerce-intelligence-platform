      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS value FROM user_events WHERE lower(event_type) IN ('product_click','product_clicked') AND $__timeFilter(event_time)",
          "editorMode": "code"
        }
      ],
      "description": "Counts product_click and product_clicked events in internal synthetic user_events. A zero means no matching event was recorded in the selected range."
    },
    {
      "id": 5,
      "title": "Cart Abandonment",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-ds"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percent",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH session_activity AS (SELECT session_id, bool_or(event_type='add_to_cart') AS added_to_cart, bool_or(event_type='purchase') AS purchased FROM user_events WHERE session_id IS NOT NULL AND $__timeFilter(event_time) GROUP BY session_id) SELECT round(100.0*count(*) FILTER (WHERE added_to_cart AND NOT purchased)::numeric/NULLIF(count(*) FILTER (WHERE added_to_cart),0)::numeric,2) AS value FROM session_activity",
          "editorMode": "code"
        }
      ],
      "description": "Internal synthetic sessions with add_to_cart but no purchase in the selected time range, as a percentage from 0 to 100."
    },
    {
      "id": 6,
      "title": "Device Distribution",
      "type": "piechart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-ds"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "pieType": "pie",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) FILTER (WHERE lower(device_type)='desktop')::double precision AS desktop, COUNT(*) FILTER (WHERE lower(device_type)='mobile')::double precision AS mobile, COUNT(*) FILTER (WHERE lower(device_type) NOT IN ('desktop','mobile'))::double precision AS other FROM user_events WHERE $__timeFilter(event_time)",
          "editorMode": "code"
        }
      ]
    },
