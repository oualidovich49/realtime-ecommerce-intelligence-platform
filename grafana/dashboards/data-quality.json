{
  "id": null,
  "uid": "data-quality",
  "title": "Data Quality",
  "description": "Automated PostgreSQL checks cover internal synthetic transactions, external DummyJSON sample data, and simulated event ingestion. This dashboard reports check results, not a claim that source datasets are production customer data.",
  "tags": [
    "ecommerce",
    "analytics"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "id": 99,
      "title": "Data source",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Scope:** automated checks on internal synthetic transactions, external DummyJSON sample records, and simulated event data. Results are stored in PostgreSQL; stale API ingestion is a warning, while integrity violations fail the run."
      }
    },
    {
      "id": 1,
      "title": "Latest Quality Run Status",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-ds"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT status AS value FROM data_quality_runs ORDER BY started_at DESC LIMIT 1",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 2,
      "title": "Failed Checks",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-ds"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE((SELECT checks_failed FROM data_quality_runs ORDER BY started_at DESC LIMIT 1),0) AS value",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 3,
      "title": "Warnings",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-ds"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE((SELECT checks_warned FROM data_quality_runs ORDER BY started_at DESC LIMIT 1),0) AS value",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 4,
      "title": "Quality Runs Over Time",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-ds"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "showPoints": "always"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(started_at,'1d') AS time, COUNT(*) FILTER (WHERE status='passed')::double precision AS passed, COUNT(*) FILTER (WHERE status='warning')::double precision AS warning, COUNT(*) FILTER (WHERE status='failed')::double precision AS failed FROM data_quality_runs WHERE $__timeFilter(started_at) GROUP BY 1 ORDER BY 1",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 5,
      "title": "Latest Check Results",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-ds"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT r.rule_name, r.source_table, r.severity, r.status, r.failed_rows, r.details, r.recorded_at FROM data_quality_results r JOIN data_quality_runs q USING(run_id) WHERE q.run_id=(SELECT run_id FROM data_quality_runs ORDER BY started_at DESC LIMIT 1) ORDER BY r.result_id",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 6,
      "title": "Findings by Rule",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-ds"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT rule_name, SUM(failed_rows) AS findings FROM data_quality_results WHERE $__timeFilter(recorded_at) GROUP BY rule_name ORDER BY findings DESC, rule_name",
          "editorMode": "code"
        }
      ]
    }
  ],
  "annotations": {
    "list": []
  },
