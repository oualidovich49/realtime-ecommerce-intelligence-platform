        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT destination_country, COUNT(*) AS shipments FROM shipments WHERE $__timeFilter(updated_at) GROUP BY destination_country ORDER BY shipments DESC",
          "editorMode": "code"
        }
