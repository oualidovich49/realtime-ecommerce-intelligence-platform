{
  "id": null,
  "uid": "payment-monitoring",
  "title": "Payment Monitoring",
  "description": "Internal synthetic payment records from PostgreSQL; no real payment activity is shown.",
  "tags": [
    "ecommerce",
    "analytics"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "id": 99,
      "title": "Data source",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Data source:** internal synthetic payment records. No real payment activity is represented."
      }
    },
    {
      "id": 1,
      "title": "Total Payments",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-ds"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS value FROM payments WHERE $__timeFilter(created_at)",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 2,
      "title": "Successful Transactions",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-ds"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS value FROM payments WHERE lower(payment_status) IN ('success','succeeded','completed') AND $__timeFilter(created_at)",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 3,
      "title": "Failed Transactions",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-ds"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS value FROM payments WHERE lower(payment_status) IN ('failed','failure') AND $__timeFilter(created_at)",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 4,
      "title": "Payment Failure Rate",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-ds"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(100.0*COUNT(*) FILTER (WHERE lower(payment_status) IN ('failed','failure'))/NULLIF(COUNT(*),0),0) AS value FROM payments WHERE $__timeFilter(created_at)",
          "editorMode": "code"
        }
      ],
      "description": "Failed internal synthetic payments divided by all payments in the selected range, as a percentage from 0 to 100."
    },
    {
      "id": 5,
      "title": "Payment Method Distribution",
      "type": "piechart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-ds"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "pieType": "pie",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) FILTER (WHERE lower(payment_method)='card')::double precision AS card, COUNT(*) FILTER (WHERE lower(payment_method)='paypal')::double precision AS paypal, COUNT(*) FILTER (WHERE lower(payment_method) NOT IN ('card','paypal'))::double precision AS other FROM payments WHERE $__timeFilter(created_at)",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 6,
      "title": "Payment Volume Over Time",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-ds"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "showPoints": "always"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(created_at,'1d') AS time, SUM(amount)::double precision AS amount FROM payments WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 7,
      "title": "Recent Failed Payments",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-ds"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT transaction_id, order_id, payment_method, amount, currency, payment_status, created_at FROM v_recent_failed_payments WHERE $__timeFilter(created_at) ORDER BY created_at DESC",
          "editorMode": "code"
        }
      ]
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 0,
  "links": [],
