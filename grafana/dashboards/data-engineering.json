    {
      "id": 3,
      "title": "Errors by Severity",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-ds"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
