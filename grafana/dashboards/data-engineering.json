      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH errors AS (SELECT severity, COUNT(*) AS events FROM system_events WHERE upper(severity) IN ('ERROR','CRITICAL','FATAL') AND $__timeFilter(event_time) GROUP BY severity) SELECT severity, events FROM errors UNION ALL SELECT 'No errors', 0::bigint WHERE NOT EXISTS (SELECT 1 FROM system_events WHERE upper(severity) IN ('ERROR','CRITICAL','FATAL') AND $__timeFilter(event_time))",
          "editorMode": "code"
        }
      ],
      "description": "An explicit zero-valued 'No errors' category is returned when there are no error-level system events in the selected range."
