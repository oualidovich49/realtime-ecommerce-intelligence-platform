        },
        "showPoints": "always"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(event_time,'1d') AS time, COUNT(*)::double precision AS events FROM inventory_events WHERE $__timeFilter(event_time) GROUP BY 1 ORDER BY 1",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 5,
      "title": "Shipment Status Distribution",
      "type": "piechart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-ds"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "pieType": "pie",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) FILTER (WHERE lower(shipment_status)='delivered')::double precision AS delivered, COUNT(*) FILTER (WHERE lower(shipment_status)='in_transit')::double precision AS in_transit, COUNT(*) FILTER (WHERE lower(shipment_status)='preparing')::double precision AS preparing, COUNT(*) FILTER (WHERE lower(shipment_status) NOT IN ('delivered','in_transit','preparing'))::double precision AS other FROM shipments WHERE $__timeFilter(updated_at)",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 6,
      "title": "Delayed Shipments",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-ds"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH delayed AS (SELECT shipment_id, tracking_number, carrier, shipment_status, shipped_at, destination_country FROM v_delayed_shipments WHERE $__timeFilter(shipped_at)) SELECT shipment_id, tracking_number, carrier, shipment_status, shipped_at, destination_country FROM delayed UNION ALL SELECT NULL::bigint, 'No delayed shipments'::text, NULL::text, 'none'::text, NULL::timestamptz, NULL::text WHERE NOT EXISTS (SELECT 1 FROM delayed) ORDER BY shipped_at",
          "editorMode": "code"
        }
      ],
      "description": "An explicit placeholder is returned when there are no delayed shipments in the selected range."
    },
    {
      "id": 7,
      "title": "Shipments by Country",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-ds"
